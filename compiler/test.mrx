	}
}

mem<> bubbleSort(mem<32>[..] arr, mem<32> n){
	for (mem<32> i = 0; i < n - 1; i++) {
		mem<32> swapped = 0;
		for (mem<32> j = 0; j < n - i - 1; j++) {
			if (arr[j] > arr[j + 1]) {
				swap(&arr[j], &arr[j + 1]);
				swapped = 1;
			}
		}
		if (swapped == 0) {
			break;
		}
	}
}

mem<32> binarySearch(mem<32>[..] arr, mem<32> n, mem<32> target){
	mem<32> left = 0;
	mem<32> right = n;
	err = 0;

	while (left < right) {
		mem<32> mid = left + (right - left) / 2;
		if (arr[mid] == target) {
			return mid;
		}
		if (arr[mid] < target) {
			left = mid + 1;
		} else {
			right = mid;
		}
	}
	err = 1;
	return 0;
}

