mem<32> fibRec(mem<32> n){
	if (n <= 1) {
		return n;
	}
	return fibRec(n - 1) + fibRec(n - 2);
}

mem<32> fibIter(mem<32> n){
	if (n == 0) { return 0; }
	if (n == 1) { return 1; }

	mem<32> a = 0;
	mem<32> b = 1;
	mem<32> c = 0;

	for (mem<32> i = 2; i <= n; i++) {
		c = a + b;
		a = b;
		b = c;
	}
	return b;
}

mem<32> gcd(mem<32> a, mem<32> b){
	while (b != 0) {
		mem<32> t = b;
		b = a % b;
		a = t;
	}
	return a;
}

mem<32> power(mem<32> base, mem<32> exp){
	mem<32> result = 1;
	while (exp > 0) {
		if (exp & 1) {
			result = result * base;
		}
		base = base * base;
		exp = exp >> 1;
	}
	return result;
}

mem<> swap(mem<32>* a, mem<32>* b){
	mem<32> tmp = *a;
	*a = *b;
	*b = tmp;
