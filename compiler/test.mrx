	return b;
}

mem<32> gcd(mem<32> a, mem<32> b){
	while (b != 0) {
		mem<32> t = b;
		b = a % b;
		a = t;
	}
	return a;
}

mem<32> power(mem<32> base, mem<32> exp){
	mem<32> result = 1;
	while (exp > 0) {
		if (exp & 1) {
			result = result * base;
		}
		base = base * base;
		exp = exp >> 1;
	}
	return result;
}

mem<> swap(mem<32>* a, mem<32>* b){
	mem<32> tmp = *a;
	*a = *b;
	*b = tmp;
}

mem<32> partition(mem<32>[..] arr, mem<32> low, mem<32> high){
	mem<32> pivot = arr[high];
	mem<32> i = low;

	for (mem<32> j = low; j < high; j++) {
		if (arr[j] <= pivot) {
			swap(&arr[i], &arr[j]);
			i = i + 1;
		}
	}
	swap(&arr[i], &arr[high]);
	return i;
}

