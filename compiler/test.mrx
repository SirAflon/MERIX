		arr[i] = arr[j];
		arr[j] = tmp;
		i = i + 1;
		j = j - 1;
	}
}

mem<32> sumArray(mem<32>[..] arr, mem<32> n){
	mem<32> total = 0;
	for (mem<32> i = 0; i < n; i++) {
		total = total + arr[i];
	}
	return total;
}

